      "must": [["einv\\.sunpay\\.com\\.tw"], ["不行|不可以|不能|不是|後台|not"]],
      "source": "https://www.sunpay.com.tw/developers/",
      "trust": "官方文件"
    },
    {
      "id": "sunpay-validate-token",
      "question": "紅陽 SunPay 電子發票 API 有哪一支端點只驗證 Token、不產生發票資料，適合先拿來確認加密實作？",
      "must": [["ValidateToken"]],
      "source": "https://www.sunpay.com.tw/developers/",
      "trust": "官方文件"
    },
    {
      "id": "sunpay-three-sales-amounts",
      "question": "紅陽 SunPay B2C 開立發票時，哪三個銷售額欄位是必填（即使是 0 也要帶）？",
      "must": [["\\bsalesAmount"], ["zeroTaxSalesAmount"], ["freeTaxSalesAmount"]],
      "source": "https://www.sunpay.com.tw/developers/",
      "trust": "官方文件"
    },
    {
      "id": "opay-timestamp-window",
